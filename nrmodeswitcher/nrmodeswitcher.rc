service vendor.nrmodeswitcher /vendor/bin/nrmodeswitcher
    class late_start
    user radio
    group radio
    oneshot

# MBN load after SIM/PLMN can reset NR mode; re-apply SA_PRE.
on property:sys.boot_completed=1
    start vendor.nrmodeswitcher

on property:gsm.sim.operator.numeric=*
    start vendor.nrmodeswitcher
